# Supabase project settings -> API. Use a dedicated NetPulse demo project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Groq Console. Server-only, never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=your-groq-key

# Exact public app origin; required behind Render/reverse proxies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Current account-accessible JSON model (verified 15 October 2026).
GROQ_MODEL=openai/gpt-oss-20b
